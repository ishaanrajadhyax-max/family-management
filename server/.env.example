# Copy this file to .env and fill in your own values. .env is gitignored
# and must never be committed or shared — it holds your database password.

PGHOST=localhost
PGPORT=5432
PGDATABASE=family_manager
PGUSER=postgres
PGPASSWORD=

# Port this API server listens on.
PORT=4000

# Origin the frontend dev server runs at, allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Signs session cookies. Generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Powers Jarvis (AI chat). Get one at console.anthropic.com -> API Keys.
# Optional in the sense that the rest of the app works without it — only
# the /api/jarvis/* routes return a 503 until this is set.
ANTHROPIC_API_KEY=
