# Copy this file to .env and fill in your own values. .env is gitignored
# and must never be committed or shared — it holds your database password.

PGHOST=localhost
PGPORT=5432
PGDATABASE=family_manager
PGUSER=postgres
PGPASSWORD=

# Port this API server listens on.
PORT=4000

# Origin the frontend dev server runs at, allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Signs session cookies. Generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Which LLM Jarvis talks to: "anthropic" or "groq". Defaults to "groq"
# if unset (Groq has a free tier, keeping this a ₹0-mandatory-cost
# deployment). Only the key for whichever provider is selected actually
# needs to be set below.
LLM_PROVIDER=groq

# Powers Jarvis when LLM_PROVIDER=groq (the default). Free tier — get one
# at console.groq.com -> API Keys.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b, which is on Groq's free plan
# and supports tool calling. Override (e.g. openai/gpt-oss-20b) without a
# code change if Groq's catalog or free-plan list moves.
# GROQ_MODEL=openai/gpt-oss-120b

# Powers Jarvis when LLM_PROVIDER=anthropic. Get one at
# console.anthropic.com -> API Keys.
# The app works fine with neither of these two set — only the
# /api/jarvis/* routes return a 503 until whichever provider is selected
# has its key configured.
ANTHROPIC_API_KEY=

# Jarvis's spoken voice: Unreal Speech, "Will" voice (server-side only — the
# key is never sent to the browser). Free plan: 250K characters/month, no
# card. Get a key at unrealspeech.com. Leave it unset and Jarvis simply
# speaks with the browser's built-in voice instead.
# Which server voice to use: "unreal" (default). Set to anything else, e.g.
# "browser", to switch the server voice off entirely.
TTS_PROVIDER=unreal
UNREAL_SPEECH_API_KEY=
# Voice: Scarlett, Dan, Liv, Will or Amy. Default Will.
UNREAL_SPEECH_VOICE=Will

# Optional spend guards (all have safe defaults). The monthly default sits
# below the free allowance on purpose; when any limit is hit, Jarvis falls
# back to the browser voice rather than going over.
# TTS_MAX_CHARS_PER_REQUEST=600
# TTS_DAILY_CHAR_LIMIT=12000
# TTS_MONTHLY_CHAR_LIMIT=200000
# TTS_MAX_REQUESTS_PER_MINUTE=15

# Optional delivery tuning for "calm, slightly deep": Speed -1..1, Pitch 0.5..1.5.
# UNREAL_SPEECH_SPEED=-0.1
# UNREAL_SPEECH_PITCH=0.95
